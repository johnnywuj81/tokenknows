# TokenKnows API · 环境变量模板
#
# 用法: cp .env.example .env.local 后填入真实 key
# .env.local 已在根 .gitignore 内, 不会入 git

# ─── LLM Provider Keys ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxx
MINIMAX_API_KEY=sk-xxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ─── LLM Gateway 三层出域 ────────────────────────────────────────
INSTANCE_EGRESS_ENABLED=true
DEFAULT_PROJECT_EGRESS_ENABLED=true

# ─── task → model 路由 ────────────────────────────────────────────
TASK_VALUE_EXTRACTION_PROVIDER=minimax
TASK_VALUE_EXTRACTION_MODEL=abab6.5s-chat
TASK_WEEKLY_REPORT_PROVIDER=anthropic
TASK_WEEKLY_REPORT_MODEL=claude-sonnet-4-5-20250929
TASK_TECH_DESIGN_PROVIDER=anthropic
TASK_TECH_DESIGN_MODEL=claude-sonnet-4-5-20250929
TASK_ADR_PROVIDER=anthropic
TASK_ADR_MODEL=claude-sonnet-4-5-20250929
TASK_INCIDENT_PROVIDER=anthropic
TASK_INCIDENT_MODEL=claude-sonnet-4-5-20250929
TASK_REDACTION_LLM_PROVIDER=minimax
TASK_REDACTION_LLM_MODEL=abab6.5s-chat

# ─── 服务 ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=local

# ─── 审计 ────────────────────────────────────────────────────────
EGRESS_LOG_PATH=./data/egress.sqlite
