# TokenKnows API · 本地开发环境变量模板
# cp .env.local.example .env.local 后填入真实值, .env.local 永远不入 git.

# ─── LLM Provider Keys (3 个全选 1 个即可) ────────────────────────
# 默认走 Ollama (本机 11434), 无需配 anthropic/openai/minimax 的 key.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Ollama (本地 LLM, 真 demo 默认走这条)
# docker compose 时, 容器内会自动指向 host.docker.internal:11434
OLLAMA_API_KEY=ollama-local
OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── LLM Gateway 三层出域门禁 ────────────────────────────────────
INSTANCE_EGRESS_ENABLED=true
DEFAULT_PROJECT_EGRESS_ENABLED=true

# ─── 任务路由 (实测可用: ollama + minimax-m2:cloud) ──────────────
TASK_VALUE_EXTRACTION_PROVIDER=ollama
TASK_VALUE_EXTRACTION_MODEL=minimax-m2:cloud

TASK_WEEKLY_REPORT_PROVIDER=ollama
TASK_WEEKLY_REPORT_MODEL=minimax-m2:cloud

TASK_TECH_DESIGN_PROVIDER=ollama
TASK_TECH_DESIGN_MODEL=minimax-m2:cloud

TASK_ADR_PROVIDER=ollama
TASK_ADR_MODEL=minimax-m2:cloud

TASK_INCIDENT_PROVIDER=ollama
TASK_INCIDENT_MODEL=minimax-m2:cloud

TASK_REDACTION_LLM_PROVIDER=ollama
TASK_REDACTION_LLM_MODEL=minimax-m2:cloud

# ─── 服务运行 ────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO
ENVIRONMENT=local

# ─── 持久化 ─────────────────────────────────────────────────────
EGRESS_LOG_PATH=./data/egress.sqlite
# (state.sqlite 由 app/persistence/store.py 自动放同目录)

# ─── 数据库 (MVP 不启用; Phase 2 切 Postgres 时打开) ─────────────
# DATABASE_URL=postgresql+asyncpg://postgres:tokenknows@localhost:5433/tokenknows
# REDIS_URL=redis://localhost:6379/0
